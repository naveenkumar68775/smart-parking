PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart_parking

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret_access
JWT_REFRESH_SECRET=replace_with_long_random_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (for CORS + password reset links)
CLIENT_URL=http://localhost:5173

# Parking billing
DEFAULT_HOURLY_RATE=20

# SMTP (optional - if not set, emails are logged to console instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Parking <no-reply@smartparking.com>"
